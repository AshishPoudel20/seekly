{
  "expo": {
    "name": "Seekly",
    "slug": "seekly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seekly.app"
    },
    "android": {
      "package": "com.seekly.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0612",
        "foregroundImage": "./assets/seekly-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0212989d-c89f-4634-9578-1941bc1322e9"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0612",
          "image": "./assets/seekly-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
